    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "typescript": "^6.0.3",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
